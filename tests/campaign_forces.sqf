OT_mapEnemyFaction = "BLU_T_F";
OT_faction_NATO = "BLU_F";
OT_spawnTowns = ["StartA", "StartB"];
private _catalog = [] call OT_fnc_campaignForces;
private _ids = _catalog apply { _x # 0 };
["The map default is the first choice", (_ids # 0) isEqualTo "BLU_T_F"] call _check;
["The map default is not duplicated", count _ids isEqualTo count (_ids arrayIntersect _ids)] call _check;
["Vanilla NATO remains available", "BLU_F" in _ids] call _check;
["Only BLUFOR factions with West group definitions are listed", _ids findIf { getNumber (configFile >> "CfgFactionClasses" >> _x >> "side") isNotEqualTo 1 || { !isClass (configFile >> "CfgGroups" >> "West" >> _x) } } isEqualTo -1] call _check;
["CSAT and AFRF are not occupation choices", !("OPF_F" in _ids) && { !("rhs_faction_msv" in _ids) }] call _check;
{
    private _present = ([_x, "BLU_F"] call OT_fnc_resolveEnemyFaction) isEqualTo _x;
    ["Optional force visibility follows installed support: " + _x, (_x in _ids) isEqualTo _present] call _check;
} forEach ["rhs_faction_usarmy_wd", "rhs_faction_usarmy_d", "rhs_faction_usmc_wd", "rhs_faction_usmc_d", "UK3CB_AAF_B"];
if (missionNamespace getVariable ["OT_campaignForceExpectRHS", false]) then {
    ["The full-mod fixture exposes all four USAF armies", ["rhs_faction_usarmy_wd", "rhs_faction_usarmy_d", "rhs_faction_usmc_wd", "rhs_faction_usmc_d"] findIf { !(_x in _ids) } isEqualTo -1] call _check;
    ["The full-mod fixture exposes the installed 3CB army", "UK3CB_AAF_B" in _ids] call _check;
};
["Legacy two-argument campaign requests remain valid", (["StartA", [1, 1, 1]] call OT_fnc_validateNewGameOptions) # 0] call _check;
["A supported explicit force is accepted", (["StartA", [1, 1, 1], "BLU_T_F"] call OT_fnc_validateNewGameOptions) # 0] call _check;
{
    ["Invalid force request rejected: " + str _forEachIndex, !((["StartA", [1, 1, 1], _x] call OT_fnc_validateNewGameOptions) # 0)] call _check;
} forEach ["OPF_F", "missing_force", true, [], 1];
server setVariable ["money", 1234];
["BLU_T_F"] call OT_fnc_applyCampaignForce;
["The chosen force becomes the server's active army", OT_faction_NATO isEqualTo "BLU_T_F" && { server getVariable ["OT_enemyFaction", ""] isEqualTo "BLU_T_F" }] call _check;
private _army = []; { _army append (_x # 1) } forEach OT_NATOGarrisonPools;
["The selected-army garrison pool is rebuilt", _army isNotEqualTo [] && { _army findIf { getText (configFile >> "CfgVehicles" >> _x >> "faction") isNotEqualTo "BLU_T_F" } isEqualTo -1 }] call _check;
["Applying a force does not reset shared funds", server getVariable "money" isEqualTo 1234] call _check;
OT_mapEnemyFaction = "BLU_F";
OT_faction_NATO = "BLU_F";
// The actual save/load path must retain a force even when the lobby differs.
OT_saving = false;
OT_NATOInitDone = true;
OT_autoSave_time = 0;
OT_saveName = "CampaignForceRegressionOnly";
OT_flag_IND = "Flag_Altis_F";
OT_item_safe = "Land_PlasticCase_01_small_F";
OT_item_Storage = "Box_NATO_Ammo_F";
OT_objectiveData = [];
OT_airportData = [];
OT_Recruitables = [];
OT_Loadout_Police = getUnitLoadout "I_Soldier_F";
[objNull, true, true] call OT_fnc_saveGame;
private _data = missionProfileNamespace getVariable [OT_saveName, []];
private _savedServer = (_data select { (_x # 0) isEqualTo "server" }) # 0 # 1;
["The real campaign save contains the force", (_savedServer select { toLower (_x # 0) isEqualTo "ot_enemyfaction" }) isEqualTo [["ot_enemyfaction", "BLU_T_F"]]] call _check;
server = true call CBA_fnc_createNamespace;
server setVariable ["OT_enemyFaction", "BLU_F"];
[_data] call OT_fnc_loadGame;
["Loading restores the saved army instead of the lobby army", OT_faction_NATO isEqualTo "BLU_T_F" && { server getVariable "OT_enemyFaction" isEqualTo "BLU_T_F" }] call _check;
_army = []; { _army append (_x # 1) } forEach OT_NATOGarrisonPools;
["Loading rebuilds the matching garrison pool", _army findIf { getText (configFile >> "CfgVehicles" >> _x >> "faction") isNotEqualTo "BLU_T_F" } isEqualTo -1] call _check;
server = true call CBA_fnc_createNamespace;
server setVariable ["OT_enemyFaction", "BLU_F"];
[[["server", []]]] call OT_fnc_loadGame;
["A legacy save retains the configured lobby army", OT_faction_NATO isEqualTo "BLU_F"] call _check;
server = true call CBA_fnc_createNamespace;
[[["server", [["OT_enemyFaction", "missing_saved_mod_force"]]]]] call OT_fnc_loadGame;
["A removed optional force falls back to the map's army", OT_faction_NATO isEqualTo "BLU_F" && { server getVariable "OT_enemyFaction" isEqualTo "BLU_F" }] call _check;
server = true call CBA_fnc_createNamespace;
server setVariable ["OT_enemyFaction", "BLU_F"];
server setVariable ["OT_startupOwner", player];
["StartA", [1, 1, 1], "OPF_F"] call OT_fnc_newGame;
["An unsupported force cannot begin a campaign", server getVariable ["StartupType", ""] isEqualTo "" && { !(server getVariable ["OT_startupInProgress", false]) } && { server getVariable "OT_enemyFaction" isEqualTo "BLU_F" }] call _check;
["The new controls use a real combo with a stable ID", getNumber (configFile >> "OT_dialog_newgame" >> "controls" >> "Force" >> "type") isEqualTo 4 && { getNumber (configFile >> "OT_dialog_newgame" >> "controls" >> "Force" >> "idc") isEqualTo 2101 }] call _check;
["The force control is translated", (["OCCUPYING FORCE", "tr"] call OT_fnc_localizeText) isEqualTo "İŞGALCİ KUVVET"] call _check;
if (missionNamespace getVariable ["OT_campaignForceExpectRHS", false]) then {
    OT_allTowns = [];
    OT_regions = [];
    OT_economyInitDone = nil;
    ["StartA", [2, 1, 1], "rhs_faction_usarmy_wd"] call OT_fnc_newGame;
    ["A real new campaign can start with RHS USAF", server getVariable ["StartupType", ""] isEqualTo "NEW" && { OT_faction_NATO isEqualTo "rhs_faction_usarmy_wd" }] call _check;
    private _usaf = []; { _usaf append (_x # 1) } forEach OT_NATOGarrisonPools;
    ["RHS new campaign has USAF garrison soldiers", _usaf isNotEqualTo [] && { _usaf findIf { getText (configFile >> "CfgVehicles" >> _x >> "faction") isNotEqualTo "rhs_faction_usarmy_wd" } isEqualTo -1 }] call _check;
    [objNull, true, true] call OT_fnc_saveGame;
    private _rhsSave = missionProfileNamespace getVariable [OT_saveName, []];
    server = true call CBA_fnc_createNamespace;
    server setVariable ["OT_enemyFaction", "BLU_F"];
    OT_faction_NATO = "BLU_F";
    [_rhsSave] call OT_fnc_loadGame;
    ["The real save/load path restores an RHS campaign", OT_faction_NATO isEqualTo "rhs_faction_usarmy_wd" && { server getVariable "OT_enemyFaction" isEqualTo "rhs_faction_usarmy_wd" }] call _check;
    ["UK3CB_AAF_B"] call OT_fnc_applyCampaignForce;
    private _aaf = []; { _aaf append (_x # 1) } forEach OT_NATOGarrisonPools;
    ["An installed 3CB choice has matching soldiers", _aaf isNotEqualTo [] && { _aaf findIf { getText (configFile >> "CfgVehicles" >> _x >> "faction") isNotEqualTo "UK3CB_AAF_B" } isEqualTo -1 }] call _check;
};
diag_log format ["OVERTHROW_CAMPAIGN_FORCES_PASSED=%1", _checks];
