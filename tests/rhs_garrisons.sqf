OT_NATO_Units_LevelTwo = ["B_Soldier_GL_F"];
server setVariable ["garrison" + _objective,4];
server setVariable ["airgarrison" + _objective,[]];
server setVariable ["vehgarrison" + _objective,["B_HMG_01_high_F"]];
[_objectivePos,_objective,"rhs-nato-objective"] call OT_fnc_spawnNATOObjective;
private _objects = spawner getVariable ["rhs-nato-objective",[]];
private _natoUnits = [];
{ if (_x isEqualType grpNull) then { _natoUnits append units _x } } forEach _objects;
["Regional spawner creates four infantry and one static gunner", count _natoUnits isEqualTo 5] call _check;
["Regional soldiers remain NATO and retain their home region", _natoUnits findIf { side group _x isNotEqualTo west || { (_x getVariable ["garrison",""]) isNotEqualTo _objective } } < 0] call _check;
["Regional soldiers come from current NATO or RHS BLUFOR", _natoUnits findIf { getText (configFile >> "CfgVehicles" >> typeOf _x >> "faction") isNotEqualTo "BLU_F" && { (toLowerANSI typeOf _x select [0,3]) isNotEqualTo "rhs" } } < 0] call _check;
{ deleteVehicle _x } forEach _natoUnits;
{ if (_x isEqualType grpNull) then { deleteGroup _x } else { deleteVehicle _x } } forEach _objects;
private _occupiedTown = "RHSNativeOccupiedTown";
server setVariable [_occupiedTown,[12000,14000,0]];
server setVariable ["stability" + _occupiedTown,20];
server setVariable ["garrison" + _occupiedTown,2];
[_occupiedTown,"rhs-nato-city"] call OT_fnc_spawnGendarmerie;
private _cityGroups = spawner getVariable ["rhs-nato-city",[]];
private _cityUnits = [];
{ _cityUnits append units _x } forEach _cityGroups;
["Occupied city patrol also uses the mixed garrison path", count _cityUnits isEqualTo 3 && { _cityUnits findIf { side group _x isNotEqualTo west || { (_x getVariable ["garrison",""]) isNotEqualTo _occupiedTown } } < 0 }] call _check;
["Occupied city soldiers come from current NATO or RHS BLUFOR", _cityUnits findIf { getText (configFile >> "CfgVehicles" >> typeOf _x >> "faction") isNotEqualTo "BLU_F" && { (toLowerANSI typeOf _x select [0,3]) isNotEqualTo "rhs" } } < 0] call _check;
["Heavy city patrol retains its training after mixing classes", _cityUnits findIf { rank _x isNotEqualTo "SERGEANT" || { !(_x getVariable ["OT_heavyGendarme",false]) } } < 0] call _check;
{ deleteVehicle _x } forEach _cityUnits;
{ deleteGroup _x } forEach _cityGroups;

private _templates = +([] call OT_fnc_recruitPresets);
private _rhsTemplates = _templates select { (toLowerANSI (_x # 0) select [0,3]) isEqualTo "rhs" };
["RHS recruit presets are added only when installed", (_rhsTemplates isNotEqualTo []) isEqualTo _rhs] call _check;
["Preset IDs remain unique", count _templates isEqualTo count ((_templates apply { _x # 0 }) arrayIntersect (_templates apply { _x # 0 }))] call _check;
["All discovered presets pass loadout validation", _templates findIf { !([_x # 1] call OT_fnc_validateSoldierPreset) } < 0] call _check;
["Malformed template cannot be saved", !([[]] call OT_fnc_validateSoldierPreset) && { !([[[],[],[],["U_B_CombatUniform_mcam",[["bad",-1]]],[],[],"","",[],[]]] call OT_fnc_validateSoldierPreset) }] call _check;
private _preset = if (_rhs) then { (_rhsTemplates select { getNumber (configFile >> "CfgVehicles" >> (_x # 0) >> "side") isEqualTo 1 }) # 0 # 0 } else { _templates # 0 # 0 };
private _template = (_templates select { (_x # 0) isEqualTo _preset }) # 0 # 1;
private _edited = +_template;
_edited set [6, "H_Booniehat_khk"];

server = true call CBA_fnc_createNamespace;
spawner = true call CBA_fnc_createNamespace;
sleep 0.2;
[_templates, true] call OT_fnc_recruitPresets;
private _town = "RHSPresetTown";
private _center = [12000,14000,0];
OT_allTowns = [_town];
server setVariable [_town, _center];
server setVariable ["policepos" + _town, _center];
server setVariable ["police" + _town, 2];
server setVariable ["population" + _town, 100];
server setVariable ["stability" + _town, 50];
server setVariable ["support" + _town, 50];
server setVariable ["NATOabandoned", [_town]];
spawner setVariable ["townspawnid" + _town, "rhs-town-live"];
private _group = createGroup independent;
private _actor = _group createUnit ["I_officer_F", _center, [], 0, "NONE"];
_actor setVariable ["owner", "fixture"];
_actor setVariable ["OT_trade", 3];
_actor allowDamage false;
_actor disableAI "ALL";
isNil { _actor setVariable ["money", 10000000, true] };
private _saved = false;
isNil { _saved = [_actor, _preset, _edited, _template] call OT_fnc_saveSoldierPreset };
sleep 0.05;
["Server saves a preset edit", _saved && { ((_preset call OT_fnc_getSoldier) # 2) isEqualTo _edited }] call _check;
private _stale = true;
isNil { _stale = [_actor, _preset, _template, _template] call OT_fnc_saveSoldierPreset };
["A stale editor cannot overwrite another edit", !_stale] call _check;
// Published object variables can arrive after the scheduled caller resumes.
private _viewDeadline = diag_tickTime + 3;
waitUntil {
    sleep 0.02;
    (server getVariable ["OT_recruitPresetView", []]) findIf { (_x # 0) isEqualTo _preset && { (_x # 1) isEqualTo _edited } } >= 0 || { diag_tickTime > _viewDeadline }
};
["JIP view receives the edited template", (server getVariable ["OT_recruitPresetView", []]) findIf { (_x # 0) isEqualTo _preset && { (_x # 1) isEqualTo _edited } } >= 0] call _check;
OT_Recruitables = [];
["Published global replacement cannot erase server templates", ([] call OT_fnc_recruitPresets) isNotEqualTo []] call _check;
["Legacy town police are migrated into the roster", ([_town] call OT_fnc_townGarrisonRoster) isEqualTo [["Police",2]]] call _check;
[_town, "rhs-town-live"] call OT_fnc_spawnPolice;
private _quote = ([_preset, _actor, false] call OT_fnc_getSoldier) # 0;
["Failed group creation cannot produce an invalid soldier", isNull ([[_preset,_actor,false] call OT_fnc_getSoldier,_center,grpNull,false] call OT_fnc_createSoldier)] call _check;
["Full preset price includes a uniform", ((([_preset, _actor, false] call OT_fnc_getSoldier) # 4) findIf { _x isEqualTo ((_edited # 3) # 0) }) >= 0] call _check;
private _buy = false;
private _initialMoney = _actor getVariable "money";
isNil { _buy = [_actor,"TOWN",_town,_preset,2,_quote*2] call OT_fnc_processGarrisonPreset };
sleep 0.05;
["Town purchases are charged on the server", _buy && { (_actor getVariable "money") isEqualTo (_initialMoney - _quote*2) }] call _check;
["Town roster preserves both police and selected soldiers", ([_town] call OT_fnc_townGarrisonRoster) isEqualTo [["Police",2],[_preset,2]]] call _check;
private _live = allUnits select { (_x getVariable ["polgarrison", ""]) isEqualTo _town };
private _new = _live select { (_x getVariable ["OT_garrisonPreset", ""]) isEqualTo _preset };
["Purchased NPCs use the selected class on the friendly side", count _new isEqualTo 2 && { _new findIf { typeOf _x isNotEqualTo _preset || { side group _x isNotEqualTo independent } } < 0 }] call _check;
["Purchased NPCs use the edited equipment", _new findIf { headgear _x isNotEqualTo "H_Booniehat_khk" } < 0] call _check;
private _parallelTown = "RHSSameFrameTown";
OT_allTowns pushBack _parallelTown;
server setVariable [_parallelTown,_center];
server setVariable ["policepos" + _parallelTown,_center];
server setVariable ["NATOabandoned",[_town,_parallelTown]];
spawner setVariable ["townspawnid" + _parallelTown,"rhs-same-frame"];
private _sameFrameMoney = _actor getVariable "money";
private _first = false;
private _second = false;
isNil {
    _first = [_actor,"TOWN",_parallelTown,_preset,1,_quote] call OT_fnc_processGarrisonPreset;
    _second = [_actor,"TOWN",_parallelTown,_preset,1,_quote] call OT_fnc_processGarrisonPreset;
};
sleep 0.05;
["Same-frame purchases both retain their soldiers", _first && { _second } && { ([_parallelTown] call OT_fnc_townGarrisonRoster) isEqualTo [[_preset,2]] }] call _check;
["Same-frame purchases charge exactly once per soldier", (_actor getVariable "money") isEqualTo (_sameFrameMoney - 2*_quote)] call _check;
{ if ((_x getVariable ["polgarrison",""]) isEqualTo _parallelTown) then { deleteVehicle _x } } forEach allUnits;
[_parallelTown,"",-1] call OT_fnc_changeGarrisonRoster;
["Virtual gang casualty updates the preset roster", ([_parallelTown] call OT_fnc_townGarrisonRoster) isEqualTo [[_preset,1]]] call _check;
[_parallelTown,"",0,true] call OT_fnc_changeGarrisonRoster;
private _money = _actor getVariable "money";
private _invalid = true;
isNil { _invalid = [_actor,"TOWN",_town,_preset,-1,-_quote] call OT_fnc_processGarrisonPreset };
["Invalid amounts do not charge or spawn", !_invalid && { (_actor getVariable "money") isEqualTo _money }] call _check;
isNil { _invalid = [_actor,"TOWN",_town,_preset,1,_quote+1] call OT_fnc_processGarrisonPreset };
["Changed quotes do not charge", !_invalid && { (_actor getVariable "money") isEqualTo _money }] call _check;
isNil { _invalid = [_actor,"TOWN",_town,"OT_missing_preset",1,1] call OT_fnc_processGarrisonPreset };
["Unknown presets cannot be purchased", !_invalid && { (_actor getVariable "money") isEqualTo _money }] call _check;

private _victim = _new # 0;
