["Real save stores the town's per-preset roster", _serverData findIf { toLowerANSI (_x # 0) isEqualTo toLowerANSI ("garrisonRoster" + _town) && { (_x # 1) isEqualTo [["Police",2],[_preset,1]] } } >= 0] call _check;
["Real save stores edited templates", ((_data select { (_x # 0) isEqualTo "recruitables" }) # 0 # 1) findIf { (_x # 0) isEqualTo _preset && { (_x # 1) isEqualTo _edited } } >= 0] call _check;
["Real save preserves the base's class and edited equipment", _serverData findIf { (_x # 0) isEqualTo ("resgarrison" + _baseCode) && { ((_x # 1) # 0 # 0) isEqualTo _preset } && { ((_x # 1) # 0 # 1 # 6) isEqualTo "H_Booniehat_khk" } } >= 0] call _check;
["Transient preset mirrors are excluded from the save", _serverData findIf { toLowerANSI (_x # 0) in ["ot_recruitpresetrecords","ot_recruitpresetview","ot_policepreset","ot_policepresetview"] } < 0] call _check;
{ deleteVehicle _x } forEach _live;
{ deleteVehicle _x } forEach units _baseGroup;
