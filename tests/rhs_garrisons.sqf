    ["Friendly menu also exposes installed AFRF templates", _buy && { count _converted isEqualTo 1 }] call _check;
    ["AFRF template joins the friendly side", side group (_converted # 0) isEqualTo independent] call _check;
};
server setVariable ["bases",[]];
isNil { _invalid = [_actor,"BASE","",_preset,1,_quote] call OT_fnc_processGarrisonPreset };
["An unknown or enemy base cannot receive troops", !_invalid] call _check;
server setVariable ["bases", [[_base,"PresetBase","fixture"]]];

OT_saving = false;
OT_NATOInitDone = true;
OT_autoSave_time = 0;
