// Isolated Altis test after real startup; never run in an existing campaign.
private _passed = 0;
private _check = { params ["_name", "_ok"]; if (!_ok) then { throw format ["FAIL: %1", _name] }; _passed = _passed + 1; diag_log format ["RHS GARRISON PASS: %1", _name] };
private _rhs = isClass (configFile >> "CfgPatches" >> "rhsusf_main");
private _army = OT_faction_NATO;
OT_faction_NATO = "BLU_F";
private _pools = [] call OT_fnc_initNATOGarrisonPool;
["Current NATO roles are cached", _pools isNotEqualTo [] && { _pools findIf { (_x # 0) isEqualTo "rifleman" && { (_x # 1) isNotEqualTo [] } } >= 0 }] call _check;
private _rhsClasses = [];
{ _rhsClasses append (_x # 2) } forEach _pools;
["Optional RHS pool follows loaded mods", (_rhsClasses isNotEqualTo []) isEqualTo _rhs] call _check;
["NATO never selects RHS OPFOR or Independent classes", _rhsClasses findIf { getNumber (configFile >> "CfgVehicles" >> _x >> "side") != 1 } < 0] call _check;
private _samples = [];
for "_i" from 1 to 200 do { _samples pushBack (["B_Soldier_F"] call OT_fnc_selectNATOGarrisonUnit) };
["Random NATO choices are valid soldiers", _samples findIf { !isClass (configFile >> "CfgVehicles" >> _x) || { !(_x isKindOf "CAManBase") } } < 0] call _check;
["Regular infantry keeps its role", _samples findIf { ([_x] call OT_fnc_soldierRole) isNotEqualTo "rifleman" } < 0] call _check;
["Current NATO army remains represented", _samples findIf { getText (configFile >> "CfgVehicles" >> _x >> "faction") isEqualTo "BLU_F" } >= 0] call _check;
if (_rhs) then { ["RHS and current army both appear in random selection", _samples findIf { (toLowerANSI _x select [0,3]) isEqualTo "rhs" } >= 0] call _check };
{
    private _fallback = _x;
    private _role = [_fallback] call OT_fnc_soldierRole;
    private _valid = true;
    for "_i" from 1 to 30 do { if (([[_fallback] call OT_fnc_selectNATOGarrisonUnit] call OT_fnc_soldierRole) isNotEqualTo _role) then { _valid = false } };
    ["Specialist role retained: " + _role, _valid] call _check;
} forEach ["B_Soldier_TL_F", "B_Soldier_AA_F", "B_Soldier_AT_F", "B_medic_F", "B_sniper_F", "B_spotter_F", "B_crew_F"];
["Unknown fallback does not produce a nil class", (["OT_unknown_class"] call OT_fnc_selectNATOGarrisonUnit) isEqualTo "OT_unknown_class"] call _check;
private _vehicle = createVehicle ["B_MRAP_01_hmg_F", [12000,14000,0], [], 0, "NONE"];
private _crew = [_vehicle] call OT_fnc_createNATOGarrisonCrew;
["Mixed vehicle crew occupies every native seat", count _crew isEqualTo 2 && { _crew findIf { objectParent _x isNotEqualTo _vehicle || { side group _x isNotEqualTo west } } < 0 }] call _check;
{ deleteVehicle _x } forEach _crew;
deleteVehicle _vehicle;

// Exercise the actual regional spawner, including a static-weapon crew.
private _objective = "RHSNativeObjective";
private _objectivePos = [11900,13000,0];
OT_allComms = [];
OT_NATOhvts = [];
OT_airportTerminals = [];
OT_garrisonBuildings = [];
