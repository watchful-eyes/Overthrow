if (_rhs) then {
    private _opfor = (_rhsTemplates select { getNumber (configFile >> "CfgVehicles" >> (_x # 0) >> "side") isEqualTo 0 }) # 0 # 0;
    private _opforQuote = ([_opfor,_actor,false] call OT_fnc_getSoldier) # 0;
    isNil { _buy = [_actor,"BASE","",_opfor,1,_opforQuote] call OT_fnc_processGarrisonPreset };
