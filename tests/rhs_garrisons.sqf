[_town, "rhs-town-respawn"] call OT_fnc_spawnPolice;
_live = allUnits select { alive _x && { (_x getVariable ["polgarrison", ""]) isEqualTo _town } };
["Streaming restores the exact surviving composition", count _live isEqualTo 3 && { count (_live select { (_x getVariable ["OT_garrisonPreset", ""]) isEqualTo _preset }) isEqualTo 1 }] call _check;
["Streaming retains edited preset equipment", (_live select { (_x getVariable ["OT_garrisonPreset", ""]) isEqualTo _preset }) findIf { headgear _x isNotEqualTo "H_Booniehat_khk" } < 0] call _check;

private _base = _center getPos [220,90];
server setVariable ["bases", [[_base,"PresetBase","fixture"]]];
_actor setPosATL _base;
isNil { _buy = [_actor,"BASE","",_preset,1,_quote] call OT_fnc_processGarrisonPreset };
