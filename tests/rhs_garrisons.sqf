OT_Recruitables = +_templates;
sleep 0.2;
[_data] call OT_fnc_loadGame;
["Real load restores the mixed town roster", ([_town] call OT_fnc_townGarrisonRoster) isEqualTo [["Police",2],[_preset,1]]] call _check;
["Real load restores the edited preset", ((_preset call OT_fnc_getSoldier) # 2) isEqualTo _edited] call _check;
["Real load republishes templates for late joiners", (server getVariable ["OT_recruitPresetView",[]]) findIf { (_x # 0) isEqualTo _preset && { (_x # 1) isEqualTo _edited } } >= 0] call _check;
[_town, "", 0, true] call OT_fnc_changeGarrisonRoster;
["Destroyed station clears the roster without reviving legacy police", ([_town] call OT_fnc_townGarrisonRoster) isEqualTo [["Police",0]]] call _check;
["Preset list and search use native controls", getNumber (configFile >> "OT_dialog_garrisonPresets" >> "controls" >> "Presets" >> "type") isEqualTo 5 && { getNumber (configFile >> "OT_dialog_garrisonPresets" >> "controls" >> "Search" >> "type") isEqualTo 2 }] call _check;
["Preset replies cannot target the settings window", getNumber (configFile >> "OT_dialog_garrisonPresets" >> "idd") isNotEqualTo getNumber (configFile >> "OT_dialog_options" >> "idd")] call _check;
