// Real gang groups, waypoint changes, town despawning and unchanged recruitment.
private _passed = 0;
private _check = { params ["_name", "_ok"]; if (!_ok) then { throw format ["FAIL: %1", _name] }; _passed = _passed + 1; diag_log format ["GANG PASS: %1", _name] };
server = true call CBA_fnc_createNamespace;
spawner = true call CBA_fnc_createNamespace;
owners = true call CBA_fnc_createNamespace;
OT_civilians = true call CBA_fnc_createNamespace;
sleep 0.2; // Let newly created global namespace objects finish their first engine frames.
private _home = "RaidHome";
private _town = "RaidTown";
private _region = "CodexRaidRegion";
createMarker [_region, [6000, 6000, 0]];
_region setMarkerShape "ELLIPSE"; _region setMarkerSize [4000, 4000]; _region setMarkerAlpha 0;
OT_regions = [_region]; OT_connectedRegions = [];
OT_allTowns = [_home, _town];
server setVariable [_home, [5000, 6000, 0]];
server setVariable [_town, [5500, 6000, 0]];
server setVariable ["NATOabandoned", [_home, "CapturedBase"], true];
OT_NATOobjectives = [[[5700, 6000, 0], "RaidBase", 800], [[5600, 6000, 0], "CapturedBase", 800], [[9500, 9500, 0], "FarBase", 800]];
OT_NATOcomms = [];
OT_spawnDistance = 1000;
OT_CRIM_Unit = "O_Soldier_F";
OT_firstNames_local = ["Test"]; OT_lastNames_local = ["Raider"];
OT_faces_local = ["GreekHead_A3_01"]; OT_voices_local = ["Male01PER"];
OT_clothes_locals = ["U_C_Poloshirt_blue"]; OT_CRIM_Clothes = ["U_C_Poloshirt_blue"]; OT_CRIM_Goggles = [""]; OT_allGlasses = [""]; OT_allBackpacks = ["B_AssaultPack_khk"];
private _viewerGroup = createGroup independent;
private _viewer = _viewerGroup createUnit ["I_soldier_F", [5000, 6000, 0], [], 0, "NONE"];
_viewer enableSimulationGlobal false; _viewer allowDamage false;
OT_trackedUnitCache = [[_viewer], time + 100000];
private _groups = [];
private _makeGang = {
    params ["_id"];
    private _group = createGroup [opfor, true];
    private _ids = [];
    for "_j" from 1 to 3 do {
        private _civid = _id * 100 + _j;
        private _unit = _group createUnit [OT_CRIM_Unit, [5000, 6000, 0], [], 0, "NONE"];
        _unit enableSimulationGlobal false;
        _unit setVariable ["OT_civid", _civid, true]; _unit setVariable ["OT_gangid", _id, true];
        _ids pushBack _civid;
        OT_civilians setVariable [str _civid, [["GreekHead_A3_01", "", [0, 0], "", "Male01PER"], _id]];
    };
    OT_civilians setVariable [format ["gang%1", _id], [_ids, -1, _home, "", [5000, 6000, 0], getUnitLoadout leader _group, 350, 1, format ["Test gang %1", _id]], true];
    spawner setVariable [format ["gangspawn%1", _id], _group, true];
    spawner setVariable [format ["gangRaidLast%1", _id], time - 2000];
    _groups pushBack _group;
    _group;
};
private _a = [1] call _makeGang;
private _b = [2] call _makeGang;
private _c = [3] call _makeGang;
private _targets = [1] call OT_fnc_gangRaidTargets;
private _base = ["NATO", "RaidBase", [5700, 6000, 0]];
["Local towns can be raid targets", ["TOWN", _town, [5500, 6000, 0]] in _targets] call _check;
["A gang does not raid its own hometown", _targets findIf { (_x # 1) isEqualTo _home } isEqualTo -1] call _check;
["A nearby NATO base can be raided", _base in _targets] call _check;
["Captured bases and distant bases are excluded", _targets findIf { (_x # 1) in ["CapturedBase", "FarBase"] } isEqualTo -1] call _check;
private _members = +((OT_civilians getVariable "gang1") # 0);
private _started = false;
isNil { _started = [1, _base] call OT_fnc_startGangRaid };
["Existing gang members start a base raid", _started] call _check;
["Raids do not add units, members, or resources", count units _a isEqualTo 3 && { ((OT_civilians getVariable "gang1") # 0) isEqualTo _members } && { ((OT_civilians getVariable "gang1") # 6) isEqualTo 350 }] call _check;
["A raid orders movement and an actual search-and-destroy waypoint", (waypoints _a apply { waypointType _x }) isEqualTo ["MOVE", "SAD"]] call _check;
["Duplicate raids are rejected", !([1, _base] call OT_fnc_startGangRaid)] call _check;
spawner setVariable ["gangHomeSpawn", [_a]];
spawner setVariable ["townspawnid" + _home, "gangHomeSpawn"];
["gangHomeSpawn", [5000, 6000, 0], [5000, 6000, 0], {}, []] call OT_fnc_despawn;
["Hometown streaming cannot delete a raiding group", { alive _x } count units _a isEqualTo 3 && { _a getVariable ["OT_gangRaiding", false] }] call _check;
["Revisiting the hometown reuses the active gang group", ([1, false] call OT_fnc_ensureGangGroup) isEqualTo _a && { count units _a isEqualTo 3 }] call _check;
private _gang = +(OT_civilians getVariable "gang1");
_gang set [0, (_gang # 0) + [104]];
OT_civilians setVariable ["104", [["GreekHead_A3_01", "", [0, 0], "", "Male01PER"], 1]];
OT_civilians setVariable ["gang1", _gang, true];
isNil { [1, false] call OT_fnc_ensureGangGroup };
{ _x enableSimulationGlobal false } forEach units _a;
["Only missing virtual members are materialized", count units _a isEqualTo 4] call _check;
isNil { [1, false] call OT_fnc_ensureGangGroup };
["Repeated materialization cannot duplicate gang members", count units _a isEqualTo 4] call _check;
isNil { [2, ["TOWN", _town, [5500, 6000, 0]]] call OT_fnc_startGangRaid };
["Concurrent gang raids are globally bounded", count (spawner getVariable "OT_gangRaids") isEqualTo 2 && { !([3, _base] call OT_fnc_startGangRaid) }] call _check;
OT_trackedUnitCache = [[], time + 100000];
[2] call OT_fnc_finishGangRaid;
((units _c) # 0) setVariable ["owner", "protected-player"];
["Player-owned gang units cannot be assigned a raid", !([3, _base] call OT_fnc_startGangRaid)] call _check;
((units _c) # 0) setVariable ["owner", nil];
((units _c) # 0) setVariable ["ace_isunconscious", true];
["A raid needs at least three conscious members", !([3, _base] call OT_fnc_startGangRaid)] call _check;
((units _c) # 0) setVariable ["ace_isunconscious", false];

// Execute the unchanged recruitment loop once while physical members are away.
OT_civilians setVariable ["gangs" + _home, [1]];
OT_civilians setVariable ["autocivid", 1000];
server setVariable ["stability" + _home, 25];
server setVariable ["stability" + _town, 100];
server setVariable ["police" + _home, 10];
server setVariable ["revealedGangs", [1]];
OT_gangResourceCap = 600; OT_gangMemberCap = 15;
crim_counter = 11;
private _before = count ((OT_civilians getVariable "gang1") # 0);
[] call OT_fnc_CRIMLoop;
["Recruitment cadence and its 100-resource cost are unchanged", count ((OT_civilians getVariable "gang1") # 0) isEqualTo (_before + 1) && { ((OT_civilians getVariable "gang1") # 6) isEqualTo 275 }] call _check;
["Virtual hometown attrition cannot double-count an active raid", (server getVariable ["police" + _home, 0]) isEqualTo 10] call _check;
OT_civilians setVariable ["gangs" + _home, []];
private _raids = +(spawner getVariable "OT_gangRaids");
(_raids # 0) set [6, time - 601];
spawner setVariable ["OT_gangRaids", _raids];
isNil { [] call OT_fnc_gangRaidLoop };
["A timed-out raid transitions into a retreat", ((spawner getVariable "OT_gangRaids") # 0 # 7) isEqualTo "RETURN"] call _check;
isNil { [] call OT_fnc_gangRaidLoop };
["Completed retreats release the global raid slot", (spawner getVariable ["OT_gangRaids", []]) isEqualTo []] call _check;
spawner setVariable ["gangRaidLast3", time];
["A recent raid enforces the per-gang cooldown", !([3, _base] call OT_fnc_startGangRaid)] call _check;
spawner setVariable ["gangRaidLast3", time - 2000];
private _ownedGroup = createGroup independent;
{ [_x] joinSilent _ownedGroup; _x setVariable ["owner", "protected-player"] } forEach units _c;
spawner setVariable ["gangspawn3", _ownedGroup];
["A gang recruited into the resistance keeps its player group", isNull ([3] call OT_fnc_ensureGangGroup) && { !([3, _base] call OT_fnc_startGangRaid) } && { count units _ownedGroup isEqualTo 3 }] call _check;
sleep 0.3;
{ { deleteVehicle _x } forEach units _x; deleteGroup _x } forEach (_groups + [_ownedGroup]);
deleteVehicle _viewer; deleteGroup _viewerGroup; deleteMarker _region;
diag_log format ["OVERTHROW_GANGS_PASSED=%1", _passed];
