// Native control/RPC checks, run after admin_cheats.sqf in its isolated fixture.
disableSerialization;
private _checks = 0;
private _check = {
    params ["_name", "_ok"];
    if (!_ok) then { throw ("Admin UI regression: " + _name) };
    _checks = _checks + 1;
};
private _waitResponse = {
    private _deadline = diag_tickTime + 10;
    waitUntil { uiSleep 0.01; !(findDisplay 9250 getVariable ["pending", false]) || { diag_tickTime > _deadline } };
    if (findDisplay 9250 getVariable ["pending", false]) then { throw "Admin UI regression: server response timed out" };
};
server setVariable ["generals", []];
server_dedi = false;
call OT_fnc_optionsDialog;
private _settings = findDisplay 9230;
["A host who is not a campaign general can see the admin button", ctrlShown (_settings displayCtrl 1610) && { ctrlEnabled (_settings displayCtrl 1610) }] call _check;
["open"] call OT_fnc_adminCheatUI;
call _waitResponse;
private _display = findDisplay 9250;
["The admin dialog opens", !isNull _display] call _check;
["Current player is selected", ((_display displayCtrl 2100) lbData lbCurSel (_display displayCtrl 2100)) isEqualTo getPlayerUID player] call _check;
["All resources have stable internal IDs", [0, 1, 2] apply { (_display displayCtrl 2101) lbData _x } isEqualTo ["money", "influence", "funds"]] call _check;
["The initial snapshot comes from the server", (_display getVariable ["snapshot", []]) select [1, 3] isEqualTo [800, 120, 20]] call _check;
(_display displayCtrl 2101) lbSetCurSel 1;
call _waitResponse;
["amount", [1000]] call OT_fnc_adminCheatUI;
["The amount preset fills the editable field", ctrlText (_display displayCtrl 1400) isEqualTo "1000"] call _check;
["apply"] call OT_fnc_adminCheatUI;
call _waitResponse;
["The real Apply RPC adds influence", player getVariable "influence" isEqualTo 1120] call _check;
(_display displayCtrl 2102) lbSetCurSel 1;
(_display displayCtrl 1400) ctrlSetText "250";
["apply"] call OT_fnc_adminCheatUI;
call _waitResponse;
["The Set operation reaches the server", player getVariable "influence" isEqualTo 250] call _check;
(_display displayCtrl 2102) lbSetCurSel 2;
(_display displayCtrl 1400) ctrlSetText "300";
["apply"] call OT_fnc_adminCheatUI;
call _waitResponse;
["The Subtract operation reaches the server", player getVariable "influence" isEqualTo 0] call _check;
(_display displayCtrl 2101) lbSetCurSel 2;
call _waitResponse;
["Shared-funds operations disable the personal target selector", !ctrlEnabled (_display displayCtrl 2100)] call _check;
(_display displayCtrl 2102) lbSetCurSel 1;
(_display displayCtrl 1400) ctrlSetText "5000";
["apply"] call OT_fnc_adminCheatUI;
call _waitResponse;
["The shared-funds operation updates its snapshot", server getVariable "money" isEqualTo 5000 && { ((_display getVariable "snapshot") # 3) isEqualTo 5000 }] call _check;
(_display displayCtrl 2101) lbSetCurSel 0;
call _waitResponse;
["Personal resources enable player selection", ctrlEnabled (_display displayCtrl 2100)] call _check;
{
    private _before = missionNamespace getVariable ["OT_adminCheatRequestID", 0];
    (_display displayCtrl 1400) ctrlSetText _x;
    ["apply"] call OT_fnc_adminCheatUI;
    ["Invalid input is blocked before transmission: " + _x, (missionNamespace getVariable ["OT_adminCheatRequestID", 0]) isEqualTo _before && { player getVariable "money" isEqualTo 800 }] call _check;
} forEach ["", "abc", "12abc", "-5", "10.5", "1000000001", "999999999999999999999"];
(_display displayCtrl 1400) ctrlSetText " 200 ";
["apply"] call OT_fnc_adminCheatUI;
call _waitResponse;
["Numeric input accepts surrounding whitespace", player getVariable "money" isEqualTo 200] call _check;
_display setVariable ["request", 9000];
_display setVariable ["pending", true];
["timeout", [9000]] call OT_fnc_adminCheatUI;
["A timeout blocks changes until a read confirms balances", !ctrlEnabled (_display displayCtrl 1600) && { ctrlEnabled (_display displayCtrl 1601) } && { !ctrlEnabled (_display displayCtrl 1602) }] call _check;
["response", [9000, true, "late", getPlayerUID player, ["ignored", 999, 999, 999], "set"]] call OT_fnc_adminCheatUI;
["A late timed-out reply cannot replace the visible snapshot", ((_display getVariable "snapshot") # 1) isEqualTo 200] call _check;
["refresh"] call OT_fnc_adminCheatUI;
call _waitResponse;
["A fresh authoritative read recovers from a timeout", ctrlEnabled (_display displayCtrl 1600) && { !(_display getVariable ["uncertain", true]) }] call _check;
private _boundsOK = true;
{
    private _rect = ctrlPosition _x;
    if ((_rect # 0) < safeZoneX || { (_rect # 1) < safeZoneY } || { (_rect # 0) + (_rect # 2) > safeZoneX + safeZoneW + 0.001 } || { (_rect # 1) + (_rect # 3) > safeZoneY + safeZoneH + 0.001 }) then { _boundsOK = false };
} forEach allControls _display;
["All controls fit within the safe zone", _boundsOK] call _check;
closeDialog 0;
"tr" call OT_fnc_setLanguage;
["open"] call OT_fnc_adminCheatUI;
call _waitResponse;
_display = findDisplay 9250;
["Turkish resource names are presented without translating IDs", (_display displayCtrl 2101) lbText 1 isEqualTo "Nüfuz" && { (_display displayCtrl 2101) lbData 1 isEqualTo "influence" }] call _check;
["Turkish balances are localized", (ctrlText (_display displayCtrl 1100) find "Oyuncu parası") >= 0 && { (ctrlText (_display displayCtrl 1100) find "Direniş kasası") >= 0 }] call _check;
["Turkish action label", ctrlText (_display displayCtrl 1600) isEqualTo "Uygula"] call _check;
closeDialog 0;
"en" call OT_fnc_setLanguage;
["open"] call OT_fnc_adminCheatUI;
call _waitResponse;
_display = findDisplay 9250;
["Reopening after a language switch restores English", ctrlText (_display displayCtrl 1600) isEqualTo "Apply"] call _check;
closeDialog 0;
diag_log format ["OVERTHROW_ADMIN_CHEATS_UI_PASSED=%1", _checks];
