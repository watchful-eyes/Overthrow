// Native engine regression checks. Run only in an isolated solo-host fixture.
if (!isServer || { !hasInterface } || { !(missionNamespace getVariable ["OT_adminCheatTestFixture", false]) }) then { throw "Admin tests require an isolated solo-host fixture" };
private _checks = 0;
private _check = {
    params ["_name", "_ok"];
    if (!_ok) then { throw ("Admin tools regression: " + _name) };
    _checks = _checks + 1;
};
private _uid = getPlayerUID player;
private _request = 0;
private _send = {
    params ["_resource", "_operation", "_amount", ["_target", _uid]];
    _request = _request + 1;
    [player, _target, _resource, _operation, _amount, _request] call OT_fnc_processAdminCheat
};
server = true call CBA_fnc_createNamespace;
players_NS = true call CBA_fnc_createNamespace;
server setVariable ["money", 1000];
player setVariable ["money", 500];
player setVariable ["influence", 10];
player setVariable ["OT_loaded", true];
missionNamespace setVariable ["OT_adminCheatRequests", createHashMap];
private _read = ["money", "read", 0] call _send;
if (!(_read # 0)) then { diag_log format ["OT_ADMIN_FIXTURE_DIAGNOSTIC: result=%1, owner=%2, isPlayer=%3, inPlayerList=%4", _read, owner player, isPlayer player, player in ([] call CBA_fnc_players)] };
["Host can read authoritative balances", (_read # 0) && { ((_read # 2) select [1, 3]) isEqualTo [500, 10, 1000] }] call _check;
private _add = ["money", "add", 250] call _send;
["Money addition", (_add # 0) && { player getVariable "money" isEqualTo 750 }] call _check;
private _duplicate = [player, _uid, "money", "add", 250, _request] call OT_fnc_processAdminCheat;
["An identical retry reuses its result without adding twice", _duplicate isEqualTo _add && { player getVariable "money" isEqualTo 750 }] call _check;
private _changed = [player, _uid, "money", "set", 1000, _request] call OT_fnc_processAdminCheat;
["Reusing a request ID with a different payload is denied", !(_changed # 0) && { player getVariable "money" isEqualTo 750 }] call _check;
private _stale = [player, _uid, "money", "add", 250, _request - 1] call OT_fnc_processAdminCheat;
["An older request cannot change money", !(_stale # 0) && { player getVariable "money" isEqualTo 750 }] call _check;
["money", "set", 400] call _send;
["Money can be set explicitly", player getVariable "money" isEqualTo 400] call _check;
["money", "subtract", 900] call _send;
["Subtraction stops at zero", player getVariable "money" isEqualTo 0] call _check;
["money", "set", 0] call _send;
["An explicit zero is accepted", player getVariable "money" isEqualTo 0] call _check;
["influence", "add", 30] call _send;
["Influence addition", player getVariable "influence" isEqualTo 40] call _check;
["influence", "set", 100] call _send;
["Influence can be set", player getVariable "influence" isEqualTo 100] call _check;
["influence", "subtract", 250] call _send;
["Influence cannot become negative", player getVariable "influence" isEqualTo 0] call _check;
["funds", "add", 400] call _send;
["Shared resistance funds are changed on the server", server getVariable "money" isEqualTo 1400] call _check;
["funds", "set", 200] call _send;
["Shared funds can be set", server getVariable "money" isEqualTo 200] call _check;
["funds", "subtract", 300] call _send;
["Shared funds subtraction stops at zero", server getVariable "money" isEqualTo 0] call _check;
{
    private _result = ["money", "set", _x] call _send;
    ["Invalid amount " + str _forEachIndex + " cannot reset a balance", !(_result # 0) && { player getVariable "money" isEqualTo 0 }] call _check;
} forEach [-1, 0.5, 2000000000, "garbage"];
["money", "set", 1000000000] call _send;
private _overflow = ["money", "add", 1000] call _send;
["Overflow is rejected without changing money", !(_overflow # 0) && { player getVariable "money" isEqualTo 1000000000 }] call _check;
private _missing = ["money", "set", 50, "disconnected-player"] call _send;
["A disconnected personal target is rejected", !(_missing # 0) && { player getVariable "money" isEqualTo 1000000000 }] call _check;
private _shared = ["funds", "add", 20, "disconnected-player"] call _send;
["Shared funds do not depend on a selected player remaining online", (_shared # 0) && { server getVariable "money" isEqualTo 20 }] call _check;
player setVariable ["OT_loaded", false];
private _loading = ["money", "set", 0] call _send;
["A loading player's balance is protected", !(_loading # 0) && { player getVariable "money" isEqualTo 1000000000 }] call _check;
player setVariable ["OT_loaded", true];
private _unknown = ["money", "multiply", 10] call _send;
["Unknown operations are rejected", !(_unknown # 0)] call _check;
private _badResource = ["godmode", "set", 1] call _send;
["Unknown resources are rejected", !(_badResource # 0)] call _check;
private _badShape = [player, _uid, "money", "set", 0] call OT_fnc_processAdminCheat;
["An incomplete request cannot reset money", !(_badShape # 0) && { player getVariable "money" isEqualTo 1000000000 }] call _check;
private _badActor = [objNull, _uid, "money", "set", 0, 999] call OT_fnc_processAdminCheat;
["A missing player cannot invoke admin tools", !(_badActor # 0)] call _check;
private _snapshotRequest = _request + 1;
["money", "read", 0] call _send;
private _late = [player, _uid, "money", "set", 0, _snapshotRequest - 1] call OT_fnc_processAdminCheat;
["A refresh invalidates delayed older mutations", !(_late # 0) && { player getVariable "money" isEqualTo 1000000000 }] call _check;
["money", "set", 800] call _send;
["Setting a large money balance to a small value preserves the exact result", player getVariable "money" isEqualTo 800] call _check;
["funds", "set", 1000000000] call _send;
["funds", "set", 20] call _send;
["Setting large shared funds to a small value preserves the exact result", server getVariable "money" isEqualTo 20] call _check;
["influence", "set", 120] call _send;
// The engine does not supply a Steam UID in a standalone SP test mission.
private _saveKey = ["admin-test-fixture", _uid] select (_uid isNotEqualTo "");
[player, _saveKey] call OT_fnc_savePlayerData;
private _saved = players_NS getVariable [_saveKey, []];
["Normal player snapshots persist admin money", (_saved select { (_x # 0) isEqualTo "money" }) isEqualTo [["money", 800]]] call _check;
["Normal player snapshots persist admin influence", (_saved select { (_x # 0) isEqualTo "influence" }) isEqualTo [["influence", 120]]] call _check;
["Request replay state is not saved on players", (_saved findIf { toLower (_x # 0) find "admincheat" >= 0 }) isEqualTo -1] call _check;
["Turkish money feedback localizes", (["Player money updated: $500 -> $750.", "tr"] call OT_fnc_localizeText) isEqualTo "Oyuncu parası güncellendi: $500 -> $750."] call _check;
["Turkish influence notifications localize", (["Admin influence adjustment: 0 -> 120.", "tr"] call OT_fnc_localizeText) isEqualTo "Yönetici nüfuz düzenlemesi: 0 -> 120."] call _check;
missionNamespace setVariable ["OT_adminCheatRequestID", _request];
diag_log format ["OVERTHROW_ADMIN_CHEATS_PASSED=%1", _checks];
